# Public source repository: keep local records and runtime data outside Git.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/dsh-longtask/

/dsh-longtask/*
!/dsh-longtask/src/
!/dsh-longtask/client/
!/dsh-longtask/test/
!/dsh-longtask/scripts/
!/dsh-longtask/release/
!/dsh-longtask/package.json
!/dsh-longtask/package-lock.json
!/dsh-longtask/tsconfig.json
!/dsh-longtask/cordis.patch.yml
!/dsh-longtask/README.md
!/dsh-longtask/RELEASE.md
!/dsh-longtask/CHANGELOG.md
/dsh-longtask/release/*
!/dsh-longtask/release/*.mjs
!/dsh-longtask/release/config.example.yml

**/node_modules/
**/dist/
**/.longtask/
**/.env
**/.env.*
**/.credentials*
**/*.log
**/*.tgz
**/*.zip
**/*.pem
**/*.key
.DS_Store
Thumbs.db
