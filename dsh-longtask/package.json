{
  "name": "dsh-plugin-longtask",
  "description": "DSH 通用长任务插件：任务生命周期、专家目录、金额预算与请求账本、Watchdog 与恢复",
  "version": "0.1.2-rc.19",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "types": "dist/src/index.d.ts",
  "files": [
    "client",
    "dist/src",
    "cordis.patch.yml",
    "README.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "release/config.example.yml",
    "scripts/diagnose.mjs",
    "scripts/crm-verification.mjs",
    "scripts/export-acceptance.mjs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "diagnose": "node scripts/diagnose.mjs",
    "probe": "node dist/src/probe/run-probe.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-repeat-tool-reminder": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
